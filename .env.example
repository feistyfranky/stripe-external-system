# Server configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# SQLite Database storage path
DATABASE_PATH=./data/stripe_system.db

# Stripe API Credentials
# Replace with your test keys from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder_key
# Stripe Webhook Secret from `stripe listen` or your webhook endpoint settings
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Simulator Mode
# Set to 'true' or leave blank to enable local simulated events without Stripe credentials
SIMULATOR_ENABLED=true
